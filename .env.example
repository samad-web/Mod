# Evolution API — your self-hosted instance
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE=my-instance
EVOLUTION_API_KEY=your-api-key-here

# Your own WhatsApp JID (number@s.whatsapp.net)
# The server only processes self-sent messages from this JID.
# Format examples:
#   India:  919876543210@s.whatsapp.net
#   UAE:    971501234567@s.whatsapp.net
MY_WHATSAPP_JID=919876543210@s.whatsapp.net

# Set to false to skip sending the PDF back via WhatsApp (useful during testing)
SEND_PDF_BACK=true

# Paths (defaults are fine for most setups)
TEMPLATE_PDF=Wecare-Clinic-Business-Proposal.pdf
OUTPUT_DIR=output
